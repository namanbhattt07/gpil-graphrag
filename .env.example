# Template for local secrets/config.
#
# HOW TO USE:
#   1. Copy this file to a new file named exactly ".env" in the same folder.
#      (Terminal:  cp .env.example .env )
#   2. Fill in your real API key below in that new ".env" file.
#   3. Never commit ".env" to git — it's already listed in .gitignore so
#      `git add` will skip it automatically. This file (.env.example) has
#      NO real secrets in it, which is why it's safe to commit.

# API key for your OpenAI-compatible LLM provider (OpenAI, Azure OpenAI, etc.)
OPENAI_API_KEY=your-api-key-here

# Base URL for the API. Only change this if you're using a non-OpenAI
# OpenAI-compatible provider (Azure OpenAI, a local proxy, etc.). Leave the
# default if you're using a normal OpenAI account.
OPENAI_API_BASE=https://api.openai.com/v1

# Chat model used for GraphRAG's entity extraction (Phase 5) and the
# reasoning/inference layer (Phase 7).
LLM_MODEL=gpt-4o-mini

# Embedding model used to build GraphRAG's vector store (Phase 5/6).
EMBEDDING_MODEL=text-embedding-3-small

# Fixed seed so synthetic data generation (Phase 2) produces identical
# output every time it's run — required for reproducibility.
RANDOM_SEED=42
